---
import Logo from './Logo.astro';
import { navLinks } from '../data/site';
---

<div class="sticky top-4 z-50 w-full px-4 sm:px-6 lg:px-8">
  <header class="mx-auto max-w-7xl rounded-2xl border border-mint-accent/50 bg-white/95 px-6 py-3.5 shadow-lg shadow-teal/5">
    <div class="flex items-center justify-between gap-4">
      <Logo />

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigasi utama">
        <ul class="flex items-center gap-1">
          {
            navLinks.map((item) =>
              'children' in item ? (
                <li class="group relative">
                  <button
                    type="button"
                    class="flex cursor-pointer items-center gap-1.5 rounded-lg px-3.5 py-2.5 text-sm font-semibold text-teal transition hover:bg-mint"
                    aria-haspopup="true"
                  >
                    {item.label}
                    <svg class="h-4 w-4 opacity-70 transition group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.94a.75.75 0 111.08 1.04l-4.24 4.5a.75.75 0 01-1.08 0l-4.24-4.5a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                  <ul class="invisible absolute left-0 top-full mt-2 min-w-[220px] translate-y-2 rounded-xl border border-mint-accent/60 bg-white p-2 opacity-0 shadow-xl transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="block rounded-lg px-4 py-2.5 text-sm font-medium text-teal hover:bg-mint">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={item.href} class="rounded-lg px-3.5 py-2.5 text-sm font-semibold text-teal transition hover:bg-mint">
                    {item.label}
                  </a>
                </li>
              )
            )
          }
        </ul>
      </nav>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-teal hover:bg-mint lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu navigasi"
      >
        <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav id="mobile-menu" class="mt-3 hidden rounded-b-2xl border-t border-mint-accent/50 p-4 lg:hidden" aria-label="Navigasi mobile">
      <ul class="flex flex-col gap-1.5">
        {
          navLinks.map((item) =>
            'children' in item ? (
              <li>
                <span class="block px-3 py-1 text-xs font-bold uppercase tracking-widest text-teal-light/80">{item.label}</span>
                <ul class="mt-1 border-l border-mint-accent/50 pl-3">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="mobile-link block rounded-lg px-4 py-2 text-sm font-medium text-teal hover:bg-mint">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class="mobile-link block rounded-lg px-3 py-2 text-sm font-semibold text-teal hover:bg-mint">
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </header>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
