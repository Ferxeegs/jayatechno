---
const partners = [
  { name: 'DPMPTSP Jawa Tengah', abbr: 'DPMPTSP' },
  { name: 'Kementerian Agama Republik Indonesia', abbr: 'KEMENAG' },
  { name: 'Universitas Negeri Semarang', abbr: 'UNNES' },
  { name: 'UMKM Indonesia', abbr: 'UMKM' },
];
---

<section class="relative overflow-hidden border-y border-mint-accent/20 bg-gradient-to-b from-white to-mint/10 py-10" aria-label="Mitra dan klien">
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-white to-transparent sm:w-32" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-white to-transparent sm:w-32" aria-hidden="true"></div>

  <div class="mx-auto mb-6 max-w-7xl px-4 text-center sm:px-6">
    <p class="text-xs font-bold uppercase tracking-widest text-teal-light/90">Dipercaya oleh instansi & mitra terkemuka</p>
  </div>

  <div class="marquee-wrap relative w-full overflow-hidden py-2">
    <div class="marquee-track flex w-max gap-8 px-4">
      {
        [0, 1, 2].map((setIndex) => (
          <div class="flex gap-8" aria-hidden={setIndex > 0}>
            {partners.map((partner) => (
              <div class="flex items-center gap-4 rounded-2xl border border-slate-100 bg-white px-6 py-3.5 shadow-sm">
                <div
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-teal to-navy text-xs font-black text-yellow"
                  aria-hidden="true"
                >
                  {partner.abbr.slice(0, 3)}
                </div>
                <span class="max-w-[180px] text-xs font-bold uppercase leading-snug tracking-wider text-teal sm:text-sm">
                  {partner.name}
                </span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
