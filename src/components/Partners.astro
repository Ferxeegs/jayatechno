---
const partners = [
  { name: 'DPMPTSP Jawa Tengah', abbr: 'DPMPTSP' },
  { name: 'Kementerian Agama Republik Indonesia', abbr: 'KEMENAG' },
  { name: 'Universitas Negeri Semarang', abbr: 'UNNES' },
  { name: 'UMKM Indonesia', abbr: 'UMKM' },
];
---

<section class="border-t border-mint-accent/40 bg-white py-10 sm:py-14" aria-label="Mitra dan klien">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="sr-only">Dipercaya oleh instansi dan organisasi terkemuka</p>
    <ul class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 lg:gap-16">
      {
        partners.map((partner) => (
          <li class="flex items-center gap-3 opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0">
            <div
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-mint-accent bg-mint text-xs font-bold text-teal"
              aria-hidden="true"
            >
              {partner.abbr.slice(0, 2)}
            </div>
            <span class="max-w-[180px] text-xs font-semibold uppercase leading-snug tracking-wide text-teal sm:text-sm">
              {partner.name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
