---
import { site } from '../../data/site';
import type { Offering } from '../../data/offerings';

interface Props {
  offering: Offering;
}

const { offering } = Astro.props;
---

<section
  class="relative overflow-hidden bg-gradient-to-r from-teal to-navy py-16 text-white sm:py-20"
  aria-labelledby="offering-cta-heading"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.04\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4z\'/%3E%3C/g%3E%3C/svg%3E')]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6" data-reveal data-reveal-variant="scale">
    <h2 id="offering-cta-heading" class="text-3xl font-extrabold sm:text-4xl">
      Siap Memulai <span class="text-yellow">{offering.navLabel}</span>?
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/80">
      Tim {site.name} siap membantu merancang solusi terbaik. Konsultasi awal gratis—tanpa komitmen.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/#kontak"
        class="inline-flex items-center rounded-full bg-yellow px-8 py-3.5 text-sm font-bold text-navy shadow-lg transition hover:bg-yellow-bright"
      >
        Jadwalkan Konsultasi
      </a>
      <a
        href="/portfolio"
        class="inline-flex items-center gap-2 rounded-full border border-white/30 px-8 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10"
      >
        Lihat Portfolio <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
