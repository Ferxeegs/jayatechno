---
import SectionHeading from '../ui/SectionHeading.astro';
import type { Offering } from '../../data/offerings';

interface Props {
  offering: Offering;
}

const { offering } = Astro.props;
---

<section class="bg-mint/30 py-16 sm:py-24" aria-labelledby="offering-deliverables-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="offering-deliverables-heading"
      title="Apa yang Anda Dapatkan"
      highlight="Dapatkan"
      subtitle="Komponen layanan yang kami deliver dengan standar profesional dan dokumentasi jelas."
      align="center"
      reveal
    />

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger role="list">
      {
        offering.deliverables.map((item, i) => (
          <li data-reveal-item>
            <article class="hover-lift h-full rounded-2xl border border-mint-accent/50 bg-white p-6 shadow-sm">
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-teal to-navy text-sm font-bold text-yellow"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 text-lg font-bold text-navy">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-body">{item.description}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
