---
import SectionHeading from '../ui/SectionHeading.astro';
import type { Offering } from '../../data/offerings';

interface Props {
  offering: Offering;
}

const { offering } = Astro.props;
---

<section class="bg-mint/30 py-16 sm:py-24" aria-labelledby="offering-process-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="offering-process-heading"
      title="Alur Kerja Kami"
      highlight="Kerja"
      subtitle="Proses terstruktur agar proyek berjalan transparan dari awal hingga serah terima."
      align="center"
      reveal
    />

    <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        offering.process.map((step) => (
          <li data-reveal-item class="relative">
            <article class="h-full rounded-2xl border border-mint-accent/60 bg-white p-6 shadow-sm">
              <span class="text-3xl font-black text-mint-accent" aria-hidden="true">
                {step.step}
              </span>
              <h3 class="mt-3 text-lg font-bold text-navy">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-body">{step.description}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>
