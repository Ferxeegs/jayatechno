---
const cards = [
  { title: 'Search Engine Optimization (SEO)', icon: 'chart' },
  { title: 'Web & Apps Development', icon: 'dev' },
  { title: 'Social Media Management', icon: 'social' },
  { title: 'Marketplace Management', icon: 'cart' },
];
---

<section id="layanan" class="bg-white py-16 sm:py-24" aria-labelledby="services-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 id="services-heading" class="text-3xl font-extrabold leading-tight text-navy sm:text-4xl">
          Layanan <span class="highlight-underline">Unggulan</span> Kami
        </h2>

        <div class="relative mt-10" aria-hidden="true">
          <svg viewBox="0 0 280 300" class="mx-auto w-full max-w-xs text-teal-light/30">
            <circle cx="140" cy="150" r="120" fill="currentColor" opacity="0.15" />
          </svg>
          <svg
            viewBox="0 0 200 240"
            class="absolute left-1/2 top-1/2 w-48 -translate-x-1/2 -translate-y-1/2"
            role="img"
            aria-label="Ilustrasi layanan digital Jayatechno"
          >
            <rect x="60" y="40" width="80" height="60" rx="12" fill="#4A9084" />
            <rect x="70" y="50" width="60" height="40" rx="6" fill="#0D3B4C" />
            <circle cx="88" cy="68" r="5" fill="#F9E05E" />
            <ellipse cx="140" cy="180" rx="50" ry="12" fill="#D1EAE3" />
            <circle cx="150" cy="120" r="28" fill="none" stroke="#4A9084" stroke-width="3" />
            <line x1="170" y1="140" x2="190" y2="160" stroke="#4A9084" stroke-width="3" stroke-linecap="round" />
          </svg>
        </div>

        <p class="mt-6 text-sm leading-relaxed text-body">
          Kami menyediakan berbagai layanan digital yang lengkap untuk memenuhi segala kebutuhan bisnis dan instansi
          Anda.
        </p>
        <a
          href="#layanan"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-yellow px-6 py-3 text-sm font-bold text-navy transition hover:bg-yellow-bright"
        >
          Layanan Lainnya <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="relative">
        <div
          class="pointer-events-none absolute -inset-4 rounded-3xl bg-gradient-to-br from-slate-100 to-mint-accent/40"
          aria-hidden="true"
        ></div>
        <ul class="relative grid gap-4 sm:grid-cols-2">
          {
            cards.map((card) => (
              <li>
                <a
                  href="#kontak"
                  class="group flex min-h-[140px] flex-col justify-between rounded-2xl bg-white p-5 shadow-lg shadow-teal/5 ring-1 ring-mint-accent/50 transition hover:-translate-y-1 hover:shadow-xl"
                >
                  <div class="text-teal-light" aria-hidden="true">
                    {card.icon === 'chart' && (
                      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 17l6-6 4 4 8-10" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                    {card.icon === 'dev' && (
                      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="2" y="3" width="20" height="14" rx="2" />
                        <path d="M8 21h8M12 17v4" stroke-linecap="round" />
                      </svg>
                    )}
                    {card.icon === 'social' && (
                      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="2" y="2" width="20" height="20" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
                      </svg>
                    )}
                    {card.icon === 'cart' && (
                      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M6 6h15l-1.5 9h-12z" stroke-linejoin="round" />
                        <circle cx="9" cy="20" r="1" fill="currentColor" />
                        <circle cx="18" cy="20" r="1" fill="currentColor" />
                        <path d="M12 6V3M9 3h6" stroke-linecap="round" />
                      </svg>
                    )}
                  </div>
                  <h3 class="mt-4 text-sm font-bold leading-snug text-navy sm:text-base">{card.title}</h3>
                  <span class="mt-4 text-teal-light transition group-hover:translate-x-1" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
