---
const articles = [
  {
    title:
      'Jayatechno Hadiri FGD Penyelarasan Satuan Pendidikan Vokasi dengan Dunia Usaha & Industri Tahun 2024',
    tag: 'Kerjasama',
    gradient: 'from-teal/80 to-teal-light/60',
  },
  {
    title: 'Gathering Client Jayatechno di Jawa Timur',
    tag: 'Kerjasama',
    gradient: 'from-navy/80 to-teal/70',
  },
  {
    title: 'Kerjasama Jayatechno dengan SMK — Sinkronisasi Kurikulum & Mitra Industri',
    tag: 'Kerjasama',
    gradient: 'from-teal-light/70 to-mint-accent',
  },
];
---

<section id="kerjasama" class="bg-white py-16 sm:py-24" aria-labelledby="news-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-12">
      <h2 id="news-heading" class="text-3xl font-extrabold leading-tight text-navy sm:text-4xl">
        Kerjasama Jayatechno di Berbagai Bidang
      </h2>
      <p class="text-base leading-relaxed text-body lg:text-right">
        Kami adalah mitra terpercaya dalam bidang digital marketing dan pengembangan teknologi, dan telah bekerjasama
        dalam berbagai bidang.
      </p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {
        articles.map((article) => (
          <article class="group flex flex-col">
            <div
              class:list={[
                'relative aspect-[4/3] overflow-hidden rounded-2xl bg-gradient-to-br',
                article.gradient,
              ]}
            >
              <div class="absolute inset-0 flex items-end bg-gradient-to-t from-navy/70 to-transparent p-5">
                <p class="text-sm font-semibold leading-snug text-white">{article.title.slice(0, 48)}…</p>
              </div>
            </div>
            <span class="mt-4 inline-flex w-fit rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-body">
              {article.tag}
            </span>
            <h3 class="mt-3 flex-1 text-base font-bold leading-snug text-navy">{article.title}</h3>
            <a
              href="#kerjasama"
              class="mt-5 inline-flex w-fit items-center gap-2 rounded-xl bg-yellow px-5 py-2.5 text-sm font-bold text-navy transition hover:bg-yellow-bright"
            >
              Read More <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
