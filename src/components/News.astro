---
const articles = [
  {
    title:
      'Jaya Techno Hadiri FGD Penyelarasan Satuan Pendidikan Vokasi dengan Dunia Usaha & Industri Tahun 2024',
    tag: 'Kerjasama',
    gradient: 'from-teal via-teal-light to-mint-accent/20',
  },
  {
    title: 'Gathering Client Jaya Techno di Jawa Timur',
    tag: 'Kerjasama',
    gradient: 'from-navy via-teal to-yellow/10',
  },
  {
    title: 'Kerjasama Jaya Techno dengan SMK — Sinkronisasi Kurikulum & Mitra Industri',
    tag: 'Kerjasama',
    gradient: 'from-teal-light via-mint-accent to-white',
  },
];
---

<section id="kerjasama" class="relative overflow-hidden bg-white py-14 sm:py-28" aria-labelledby="news-heading">
  <!-- Subtle decoration -->
  <div class="pointer-events-none absolute left-1/2 -translate-x-1/2 h-[450px] w-[800px] rounded-[50%] bg-mint-accent/10 blur-3xl" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="news-header grid items-end gap-6 lg:grid-cols-2 lg:gap-12" data-reveal>
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-teal-light mb-3 block">Berita & Acara</span>
        <h2 id="news-heading" class="text-2xl font-black leading-tight tracking-tight text-navy sm:text-4xl">
          Kerjasama Jaya Techno di Berbagai Bidang
        </h2>
      </div>
      <p class="text-base sm:text-lg leading-relaxed text-body lg:text-right lg:pb-1">
        Kami adalah mitra terpercaya dalam bidang digital marketing dan pengembangan teknologi, bekerjasama membangun ekosistem digital nasional.
      </p>
    </div>

    <div class="news-grid mt-10 grid gap-5 sm:mt-16 sm:gap-8 md:grid-cols-3" data-reveal-stagger>
      {
        articles.map((article) => (
          <article data-reveal-item class="news-card group flex h-full flex-col justify-between rounded-3xl border border-slate-100 bg-white p-5 shadow-md transition duration-300 hover:border-mint-accent/60 hover:shadow-xl">
            <div>
              <!-- Stylized visual placeholder -->
              <div
                class:list={[
                  'relative aspect-[4/3] overflow-hidden rounded-2xl bg-gradient-to-br transition duration-300 group-hover:scale-[1.02]',
                  article.gradient,
                ]}
              >
                <!-- Stylized high-tech lines overlay -->
                <div class="absolute inset-0 opacity-15 bg-[linear-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] [background-size:16px_16px]"></div>
                
                <div class="absolute inset-0 flex items-end bg-gradient-to-t from-navy/90 via-navy/30 to-transparent p-5">
                  <p class="text-xs font-extrabold leading-snug text-white/95 tracking-wide line-clamp-2">
                    {article.title}
                  </p>
                </div>
              </div>

              <span class="mt-5 inline-flex w-fit rounded-full bg-mint px-3.5 py-1.5 text-xs font-extrabold tracking-wider text-teal-light uppercase">
                {article.tag}
              </span>

              <h3 class="mt-4 text-base font-extrabold leading-snug text-navy tracking-tight group-hover:text-teal transition-colors duration-200">
                {article.title}
              </h3>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100">
              <a
                href="#kerjasama"
                class="inline-flex items-center gap-2 rounded-xl bg-yellow px-5 py-3 text-xs font-black text-navy transition duration-300 hover:bg-yellow-bright cursor-pointer shadow-sm"
              >
                Baca Selengkapnya
                <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
