---
const benefits = [
  'Portofolio luas dengan berbagai sektor bisnis',
  'Strategi digital berbasis data untuk hasil optimal',
  'Layanan profesional dengan dukungan berkelanjutan',
];

const collageCards = [
  { type: 'seo', alt: 'SEO Conversion Stats', rotate: '-rotate-6', pos: 'top-4 left-4', size: 'h-24 w-32 sm:h-28 sm:w-36' },
  { type: 'code', alt: 'Software House Code Editor', rotate: 'rotate-3', pos: 'top-10 right-10', size: 'h-24 w-32 sm:h-28 sm:w-36' },
  { type: 'chart', alt: 'Analytics Score Board', rotate: '-rotate-3', pos: 'top-36 left-20', size: 'h-20 w-28 sm:h-24 sm:w-32' },
  { type: 'growth', alt: 'Social Media Growth Graph', rotate: 'rotate-6', pos: 'bottom-20 left-4', size: 'h-24 w-32 sm:h-28 sm:w-36' },
  { type: 'browser', alt: 'Web Browser Mockup', rotate: '-rotate-6', pos: 'bottom-12 right-12', size: 'h-24 w-32 sm:h-28 sm:w-36' },
  { type: 'nodes', alt: 'Cloud Network Nodes', rotate: 'rotate-2', pos: 'bottom-4 left-32', size: 'h-20 w-28 sm:h-24 sm:w-32' },
];
---

<section id="profil" class="relative overflow-hidden bg-white py-14 sm:py-28" aria-labelledby="about-heading">
  <!-- Decorative grid background -->
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(#d1eae3_1px,transparent_1px)] [background-size:24px_24px] opacity-30"></div>
  <div class="pointer-events-none absolute -right-32 top-1/3 h-96 w-96 rounded-full bg-mint-accent/20 blur-3xl" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-10 px-4 sm:gap-12 sm:px-6 lg:grid-cols-2 lg:gap-20 lg:px-8">
    <!-- Mobile: compact 2-column grid (no absolute overflow) -->
    <div class="order-2 grid grid-cols-2 gap-3 sm:hidden" data-reveal-stagger>
      {
        collageCards.map((card, i) => (
          <div
            data-reveal-item
            class:list={[
              'overflow-hidden rounded-2xl border border-white bg-white p-3 shadow-lg',
              card.size,
              i % 2 === 1 ? 'translate-y-3' : '',
            ]}
            role="img"
            aria-label={card.alt}
          >
            {card.type === 'seo' && (
              <div class="flex h-full flex-col justify-between text-left">
                <div class="flex items-center justify-between">
                  <span class="text-[9px] font-extrabold uppercase tracking-wider text-teal-light">SEO Rank</span>
                  <span class="rounded bg-yellow/80 px-1 text-[9px] font-bold text-teal">▲ 24%</span>
                </div>
                <svg class="mt-2 h-8 w-full" viewBox="0 0 100 30" fill="none">
                  <path d="M0 25 C15 25, 25 10, 45 15 C65 20, 75 2, 100 5" stroke="#4A9084" stroke-width="2.5" stroke-linecap="round" />
                </svg>
              </div>
            )}
            {card.type === 'code' && (
              <div class="flex h-full flex-col font-mono text-[8px] leading-normal text-teal/80">
                <p><span class="text-[#ff79c6]">const</span> app = () =&gt; &#123;</p>
                <p class="pl-2 text-teal-light">&lt;Solutions /&gt;</p>
              </div>
            )}
            {card.type === 'chart' && (
              <div class="flex h-full items-center justify-between gap-2">
                <span class="text-lg font-black text-teal">99%</span>
                <span class="text-[8px] font-black uppercase text-navy">Speed</span>
              </div>
            )}
            {card.type === 'growth' && (
              <div class="flex h-full items-end gap-1">
                <div class="h-6 w-2 rounded-t bg-mint-accent"></div>
                <div class="h-8 w-2 rounded-t bg-teal-light"></div>
                <div class="h-10 w-2 rounded-t bg-teal"></div>
              </div>
            )}
            {card.type === 'browser' && (
              <div class="h-full rounded bg-mint/50 p-1">
                <div class="mb-1 h-2 w-full rounded bg-white"></div>
                <div class="grid grid-cols-2 gap-1">
                  <div class="h-6 rounded bg-mint-accent/40"></div>
                  <div class="h-6 rounded bg-mint-accent/60"></div>
                </div>
              </div>
            )}
            {card.type === 'nodes' && (
              <svg class="h-full w-full text-teal-light" viewBox="0 0 100 50">
                <circle cx="20" cy="25" r="4" fill="currentColor" />
                <circle cx="50" cy="15" r="5" fill="#0D3B4C" />
                <circle cx="80" cy="25" r="5" fill="#F9E05E" />
                <line x1="24" y1="25" x2="76" y2="25" stroke="#d1eae3" stroke-width="1.5" />
              </svg>
            )}
          </div>
        ))
      }
    </div>

    <!-- Desktop: scattered collage -->
    <div class="relative order-2 mx-auto hidden aspect-square w-full min-h-[400px] max-w-md sm:order-1 sm:block lg:max-w-none">
      <div
        class="absolute inset-4 rounded-[2.5rem] border border-white/80 bg-mint-accent/40 blur-sm"
        aria-hidden="true"
      ></div>
      <div class="relative h-full w-full select-none" data-reveal-stagger>
        {
          collageCards.map((card, i) => (
            <div
              data-reveal-item
              class:list={[
                'collage-card absolute overflow-hidden rounded-2xl border border-white bg-white p-3 shadow-lg transition duration-300 hover:z-30 hover:scale-105 hover:shadow-xl',
                card.pos,
                card.rotate,
                card.size
              ]}
              style={`z-index: ${i + 1}`}
              role="img"
              aria-label={card.alt}
            >
              <!-- Card Custom High-Tech Visuals -->
              {card.type === 'seo' && (
                <div class="flex flex-col h-full justify-between text-left">
                  <div class="flex items-center justify-between">
                    <span class="text-[9px] font-extrabold uppercase tracking-wider text-teal-light">SEO Rank</span>
                    <span class="text-[9px] font-bold text-teal bg-yellow/80 px-1 rounded">▲ 24%</span>
                  </div>
                  <svg class="w-full h-8 mt-2" viewBox="0 0 100 30" fill="none">
                    <path d="M0 25 C15 25, 25 10, 45 15 C65 20, 75 2, 100 5" stroke="#4A9084" stroke-width="2.5" stroke-linecap="round" />
                    <path d="M0 25 C15 25, 25 10, 45 15 C65 20, 75 2, 100 5 L100 30 L0 30 Z" fill="url(#seo-glow)" opacity="0.1" />
                    <defs>
                      <linearGradient id="seo-glow" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#4A9084" />
                        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
                      </linearGradient>
                    </defs>
                  </svg>
                </div>
              )}

              {card.type === 'code' && (
                <div class="flex flex-col h-full font-mono text-[8px] text-left leading-normal text-teal/80">
                  <div class="flex items-center gap-1 mb-2 border-b border-mint-accent/30 pb-1">
                    <span class="h-1.5 w-1.5 rounded-full bg-[#ff5f56]"></span>
                    <span class="h-1.5 w-1.5 rounded-full bg-[#ffbd2e]"></span>
                    <span class="h-1.5 w-1.5 rounded-full bg-[#27c93f]"></span>
                  </div>
                  <p><span class="text-[#ff79c6]">const</span> app = () => &#123;</p>
                  <p class="pl-2"><span class="text-[#50fa7b]">return</span> (</p>
                  <p class="pl-4 text-teal-light">&lt;<span class="text-[#8be9fd]">Solutions</span> /&gt;</p>
                  <p class="pl-2">);</p>
                  <p>&#125;;</p>
                </div>
              )}

              {card.type === 'chart' && (
                <div class="flex items-center h-full justify-between gap-2 text-left">
                  <div class="relative flex items-center justify-center">
                    <svg class="w-10 h-10 -rotate-90">
                      <circle cx="20" cy="20" r="16" stroke="#f0f9f7" stroke-width="4" fill="none" />
                      <circle cx="20" cy="20" r="16" stroke="#0D3B4C" stroke-width="4" fill="none" stroke-dasharray="100" stroke-dashoffset="15" />
                    </svg>
                    <span class="absolute text-[8px] font-black text-teal">99%</span>
                  </div>
                  <div class="flex flex-col">
                    <span class="text-[8px] font-black text-navy uppercase leading-none">Speed</span>
                    <span class="text-[7px] text-body mt-0.5">Optimized</span>
                  </div>
                </div>
              )}

              {card.type === 'growth' && (
                <div class="flex flex-col h-full justify-between text-left">
                  <span class="text-[8px] font-bold text-[#666666] uppercase">Traffic Growth</span>
                  <div class="flex items-end gap-1.5 h-10 mt-1">
                    <div class="w-2.5 bg-mint-accent rounded-t h-4"></div>
                    <div class="w-2.5 bg-mint-accent rounded-t h-6"></div>
                    <div class="w-2.5 bg-teal-light rounded-t h-8"></div>
                    <div class="w-2.5 bg-teal rounded-t h-10 relative"><span class="absolute -top-3.5 left-1/2 -translate-x-1/2 text-[6px] font-extrabold text-teal">350%</span></div>
                  </div>
                </div>
              )}

              {card.type === 'browser' && (
                <div class="flex flex-col h-full text-left">
                  <div class="flex items-center justify-between border-b border-mint-accent/40 bg-mint/40 px-2 py-1 -mx-3 -mt-3 rounded-t-2xl">
                    <div class="flex gap-1">
                      <span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span>
                      <span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span>
                      <span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span>
                    </div>
                    <div class="h-2 w-16 bg-white rounded border border-slate-200"></div>
                  </div>
                  <div class="grid grid-cols-3 gap-1 mt-2">
                    <div class="h-7 bg-mint/50 rounded p-1 flex flex-col justify-between">
                      <span class="h-1 w-full bg-teal-light/20 rounded"></span>
                      <span class="h-1.5 w-3 bg-teal-light rounded"></span>
                    </div>
                    <div class="col-span-2 h-7 bg-mint-accent/30 rounded p-1 flex flex-col justify-between">
                      <span class="h-1 w-full bg-teal/20 rounded"></span>
                      <span class="h-1 w-2/3 bg-teal/20 rounded"></span>
                    </div>
                  </div>
                </div>
              )}

              {card.type === 'nodes' && (
                <div class="flex items-center justify-center h-full relative">
                  <svg class="w-full h-full text-teal-light" viewBox="0 0 100 50">
                    <circle cx="20" cy="25" r="4" fill="currentColor" />
                    <circle cx="50" cy="15" r="5" fill="#0D3B4C" />
                    <circle cx="50" cy="35" r="4" fill="currentColor" />
                    <circle cx="80" cy="25" r="5" fill="#F9E05E" />
                    
                    <line x1="24" y1="23" x2="45" y2="17" stroke="#d1eae3" stroke-width="1.5" />
                    <line x1="24" y1="27" x2="46" y2="33" stroke="#d1eae3" stroke-width="1.5" />
                    <line x1="55" y1="17" x2="75" y2="23" stroke="#d1eae3" stroke-width="1.5" />
                    <line x1="54" y1="33" x2="76" y2="27" stroke="#d1eae3" stroke-width="1.5" />
                  </svg>
                </div>
              )}

            </div>
          ))
        }
      </div>
    </div>

    <!-- Content -->
    <div class="about-content order-1 text-left lg:order-2" data-reveal>
      <span class="mb-3 block text-xs font-bold uppercase tracking-widest text-teal-light">Profil Perusahaan</span>
      <h2 id="about-heading" class="text-2xl font-black leading-tight tracking-tight text-navy sm:text-4xl">
        Ratusan Client <span class="highlight-underline">Sukses Terhandle</span>
      </h2>
      <p class="mt-6 text-base leading-relaxed text-body sm:text-lg">
        Dengan pengalaman lebih dari 7 tahun di industri kreatif dan digital marketing, kami telah bekerjasama dengan
        banyak client dari kalangan perusahaan, instansi, hingga UMKM.
      </p>
      
      <ul class="mt-8 space-y-4" role="list">
        {
          benefits.map((item) => (
            <li class="about-benefit flex items-start gap-3.5 group">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-mint-accent group-hover:bg-teal group-hover:text-yellow transition-all duration-300" aria-hidden="true">
                <svg class="h-3.5 w-3.5 text-teal-light group-hover:text-yellow transition-colors" viewBox="0 0 20 20" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"
                  />
                </svg>
              </span>
              <span class="text-sm font-bold text-navy/95 sm:text-base group-hover:translate-x-1 transition-transform duration-300">{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="about-action">
        <a
          href="/profil"
          class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-full bg-yellow px-8 py-3.5 text-sm font-bold text-navy shadow-md transition hover:bg-yellow-bright hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow sm:mt-10 sm:w-auto sm:py-4"
        >
          Profil Lengkap
          <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
