---
import { site } from '../data/site';
---

<section
  id="beranda"
  class="relative overflow-hidden bg-gradient-to-b from-mint/50 via-white to-white pb-20 pt-28 sm:pb-28 sm:pt-32"
  aria-labelledby="hero-heading"
>
  <div class="pointer-events-none absolute -left-32 top-10 h-[500px] w-[500px] rounded-full bg-mint-accent/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-32 bottom-10 h-[500px] w-[500px] rounded-full bg-teal-light/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
    <div class="max-w-xl text-left">
      <div
        data-reveal-hero
        class="mb-6 inline-flex items-center gap-1.5 rounded-full border border-teal-light/10 bg-teal/5 px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider text-teal shadow-sm"
      >
        <span class="flex h-2 w-2 rounded-full bg-teal-light"></span>
        Digital Creative Agency
      </div>

      <h1
        data-reveal-hero
        id="hero-heading"
        class="text-balance text-4xl font-black leading-[1.1] tracking-tight text-navy sm:text-5xl lg:text-6xl"
      >
        {site.tagline.split(' ').slice(0, 2).join(' ')}
        <span class="text-gradient mt-1 block">{site.tagline.split(' ').slice(2).join(' ')}</span>
      </h1>

      <p data-reveal-hero class="mt-6 text-base leading-relaxed text-body sm:text-lg">
        Dapatkan layanan unggulan di bidang digital marketing dan pengembangan software, dikerjakan oleh tim
        profesional berpengalaman untuk mengakselerasi transformasi digital Anda.
      </p>

      <div data-reveal-hero class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#kontak"
          class="inline-flex items-center justify-center rounded-full bg-teal px-8 py-4 text-sm font-bold text-white shadow-lg shadow-teal/20 transition hover:bg-teal/90 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal"
        >
          Konsultasi Gratis
        </a>
        <button
          type="button"
          class="group flex h-14 w-14 items-center justify-center rounded-full bg-yellow shadow-md transition hover:scale-105 hover:bg-yellow-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow"
          aria-label="Putar video profil perusahaan"
        >
          <svg class="ml-1 h-5 w-5 text-teal transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </button>
      </div>
    </div>

    <div data-reveal-hero class="relative mx-auto w-full max-w-lg lg:max-w-none">
      <div
        class="float-card-1 absolute -right-2 top-8 z-20 flex h-14 w-14 items-center justify-center rounded-2xl glass-card"
        aria-hidden="true"
      >
        <svg class="h-7 w-7 text-teal-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 17l6-6 4 4 8-10" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <svg
        viewBox="0 0 400 420"
        class="hero-mascot relative z-10 mx-auto w-full max-w-md drop-shadow-2xl lg:max-w-lg"
        role="img"
        aria-label="Maskot Jayatechno — robot digital partner"
      >
        <ellipse cx="200" cy="405" rx="150" ry="12" fill="#0D3B4C" opacity="0.1" />
        <rect x="130" y="200" width="140" height="130" rx="28" fill="#fff" stroke="#D1EAE3" stroke-width="4" />
        <text x="200" y="272" text-anchor="middle" font-size="20" font-weight="800" fill="#0D3B4C">jayatechno</text>
        <rect x="145" y="70" width="110" height="85" rx="24" fill="#fff" stroke="#D1EAE3" stroke-width="4" />
        <rect x="155" y="80" width="90" height="65" rx="16" fill="#0D3B4C" />
        <circle cx="185" cy="112" r="7" fill="#F9E05E" />
        <path d="M205 115 Q218 122 225 112" stroke="#F9E05E" stroke-width="3" fill="none" stroke-linecap="round" />
        <rect x="95" y="210" width="30" height="80" rx="15" fill="#4A9084" />
        <rect x="275" y="210" width="30" height="80" rx="15" fill="#4A9084" />
        <rect x="160" y="330" width="30" height="50" rx="15" fill="#4A9084" />
        <rect x="210" y="330" width="30" height="50" rx="15" fill="#4A9084" />
      </svg>

      <div
        class="float-card-2 absolute bottom-12 left-0 z-20 flex items-center gap-3 rounded-2xl border border-mint-accent glass-card px-5 py-3.5 sm:left-6"
        aria-hidden="true"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-yellow">
          <svg class="h-5 w-5 text-teal" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 15l-4-4 1.41-1.41L11 13.17l6.59-6.59L19 8l-8 8z" />
          </svg>
        </span>
        <div class="flex flex-col text-left">
          <span class="text-xs font-bold uppercase tracking-wider text-teal-light">Client Trust</span>
          <span class="text-sm font-extrabold text-teal">7+ Tahun Pengalaman</span>
        </div>
      </div>
    </div>
  </div>
</section>
