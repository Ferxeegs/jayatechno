---
import { site } from '../data/site';
---

<section
  id="beranda"
  class="relative overflow-hidden bg-gradient-to-b from-mint/50 via-white to-white pb-14 pt-24 sm:pb-28 sm:pt-32"
  aria-labelledby="hero-heading"
>
  <div class="pointer-events-none absolute -left-32 top-10 h-[500px] w-[500px] rounded-full bg-mint-accent/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-32 bottom-10 h-[500px] w-[500px] rounded-full bg-teal-light/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-8 px-4 sm:gap-10 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
    <div class="order-1 w-full min-w-0 text-left">
      <div
        data-reveal-hero
        class="mb-4 inline-flex max-w-full items-center gap-1.5 rounded-full border border-teal-light/10 bg-teal/5 px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-wider text-teal shadow-sm sm:mb-6 sm:px-4 sm:text-xs"
      >
        <span class="flex h-2 w-2 shrink-0 rounded-full bg-teal-light"></span>
        Digital Creative Agency
      </div>

      <h1
        data-reveal-hero
        id="hero-heading"
        class="text-balance text-[1.65rem] font-black leading-[1.15] tracking-tight text-navy sm:text-4xl lg:text-6xl"
      >
        {site.tagline.split(' ').slice(0, 2).join(' ')}
        <span class="text-gradient mt-1 block">{site.tagline.split(' ').slice(2).join(' ')}</span>
      </h1>

      <p data-reveal-hero class="mt-4 text-sm leading-relaxed text-body sm:mt-6 sm:text-base lg:text-lg">
        Dapatkan layanan unggulan di bidang digital marketing dan pengembangan software, dikerjakan oleh tim
        profesional berpengalaman untuk mengakselerasi transformasi digital Anda.
      </p>

      <div data-reveal-hero class="mt-6 flex w-full flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <a
          href="#kontak"
          class="inline-flex w-full items-center justify-center rounded-full bg-teal px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-teal/20 transition hover:bg-teal/90 sm:w-auto sm:px-8 sm:py-4"
        >
          Konsultasi Gratis
        </a>
        <button
          type="button"
          class="group mx-auto flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-yellow shadow-md transition hover:scale-105 hover:bg-yellow-bright sm:mx-0 sm:h-14 sm:w-14"
          aria-label="Putar video profil perusahaan"
        >
          <svg class="ml-1 h-5 w-5 text-teal" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </button>
      </div>
    </div>

    <div data-reveal-hero class="relative order-2 mx-auto w-full min-w-0 max-w-sm sm:max-w-md lg:max-w-none">
      <div
        class="float-card-1 absolute right-0 top-4 z-20 hidden h-12 w-12 items-center justify-center rounded-2xl glass-card sm:flex sm:h-14 sm:w-14"
        aria-hidden="true"
      >
        <svg class="h-6 w-6 text-teal-light sm:h-7 sm:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 17l6-6 4 4 8-10" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <svg
        viewBox="0 0 400 420"
        class="hero-mascot relative z-10 mx-auto w-full max-w-[280px] drop-shadow-2xl sm:max-w-md lg:max-w-lg"
        role="img"
        aria-label="Maskot Jaya Techno — robot digital partner"
      >
        <ellipse cx="200" cy="405" rx="150" ry="12" fill="#2d599e" opacity="0.1" />
        <rect x="130" y="200" width="140" height="130" rx="28" fill="#fff" stroke="#d4e2f0" stroke-width="4" />
        <text x="200" y="272" text-anchor="middle" font-size="20" font-weight="800" fill="#2d599e">jaya techno</text>
        <rect x="145" y="70" width="110" height="85" rx="24" fill="#fff" stroke="#d4e2f0" stroke-width="4" />
        <rect x="155" y="80" width="90" height="65" rx="16" fill="#2d599e" />
        <circle cx="185" cy="112" r="7" fill="#f15a24" />
        <path d="M205 115 Q218 122 225 112" stroke="#f15a24" stroke-width="3" fill="none" stroke-linecap="round" />
        <rect x="95" y="210" width="30" height="80" rx="15" fill="#5a7db5" />
        <rect x="275" y="210" width="30" height="80" rx="15" fill="#5a7db5" />
        <rect x="160" y="330" width="30" height="50" rx="15" fill="#5a7db5" />
        <rect x="210" y="330" width="30" height="50" rx="15" fill="#5a7db5" />
      </svg>

      <div
        class="float-card-2 relative z-20 mx-auto mt-4 flex max-w-[240px] items-center gap-2.5 rounded-2xl border border-mint-accent glass-card px-4 py-3 sm:absolute sm:bottom-12 sm:left-6 sm:mx-0 sm:mt-0 sm:max-w-none sm:gap-3 sm:px-5 sm:py-3.5"
        aria-hidden="true"
      >
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-yellow sm:h-9 sm:w-9">
          <svg class="h-4 w-4 text-teal sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 15l-4-4 1.41-1.41L11 13.17l6.59-6.59L19 8l-8 8z" />
          </svg>
        </span>
        <div class="min-w-0 flex flex-col text-left">
          <span class="text-[10px] font-bold uppercase tracking-wider text-teal-light sm:text-xs">Client Trust</span>
          <span class="text-xs font-extrabold text-teal sm:text-sm">5+ Tahun Pengalaman</span>
        </div>
      </div>
    </div>
  </div>
</section>
