---
import { site } from "../data/site";
---

<section
  id="beranda"
  class="relative overflow-hidden bg-gradient-to-b from-mint/50 via-white to-white pb-14 pt-24 sm:pb-28 sm:pt-32"
  aria-labelledby="hero-heading"
>
  <div
    class="pointer-events-none absolute -left-32 top-10 h-[500px] w-[500px] rounded-full bg-mint-accent/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-32 bottom-10 h-[500px] w-[500px] rounded-full bg-teal-light/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-8 px-4 sm:gap-10 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8"
  >
    <div class="order-1 w-full min-w-0 text-left">
      <div
        data-reveal-hero
        class="mb-4 inline-flex max-w-full items-center gap-1.5 rounded-full border border-teal-light/10 bg-teal/5 px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-wider text-teal shadow-sm sm:mb-6 sm:px-4 sm:text-xs"
      >
        <span class="flex h-2 w-2 shrink-0 rounded-full bg-teal-light"></span>
        Digital Creative Agency
      </div>

      <h1
        data-reveal-hero
        id="hero-heading"
        class="text-balance text-[1.65rem] font-black leading-[1.15] tracking-tight text-navy sm:text-4xl lg:text-6xl"
      >
        {site.tagline.split(" ").slice(0, 2).join(" ")}
        <span class="text-gradient mt-1 block"
          >{site.tagline.split(" ").slice(2).join(" ")}</span
        >
      </h1>

      <p
        data-reveal-hero
        class="mt-4 text-sm leading-relaxed text-body sm:mt-6 sm:text-base lg:text-lg"
      >
        Dapatkan layanan unggulan di bidang digital marketing dan pengembangan
        software, dikerjakan oleh tim profesional berpengalaman untuk
        mengakselerasi transformasi digital Anda.
      </p>

      <div
        data-reveal-hero
        class="mt-6 flex w-full flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4"
      >
        <a
          href="#kontak"
          class="inline-flex w-full items-center justify-center rounded-full bg-teal px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-teal/20 transition hover:bg-teal/90 sm:w-auto sm:px-8 sm:py-4"
        >
          Konsultasi Gratis
        </a>
        <button
          type="button"
          class="group mx-auto flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-yellow shadow-md transition hover:scale-105 hover:bg-yellow-bright sm:mx-0 sm:h-14 sm:w-14"
          aria-label="Putar video profil perusahaan"
        >
          <svg
            class="ml-1 h-5 w-5 text-teal"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      data-reveal-hero
      class="relative order-2 mx-auto w-full min-w-0 max-w-sm sm:max-w-md lg:max-w-none"
    >
      <div
        class="float-card-1 absolute right-0 top-4 z-20 hidden h-12 w-12 items-center justify-center rounded-2xl glass-card sm:flex sm:h-14 sm:w-14"
        aria-hidden="true"
      >
        <svg
          class="h-6 w-6 text-teal-light sm:h-7 sm:w-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M3 17l6-6 4 4 8-10"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>

      <svg
        viewBox="0 0 400 420"
        class="hero-mascot relative z-10 mx-auto w-full max-w-[280px] drop-shadow-2xl sm:max-w-md lg:max-w-lg"
        role="img"
        aria-label="Maskot Jaya Techno — robot digital partner"
      >
        <defs>
          <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff"></stop>
            <stop offset="100%" stop-color="#e2e8f0"></stop>
          </linearGradient>
          <linearGradient id="screenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0f172a"></stop>
            <stop offset="100%" stop-color="#1e293b"></stop>
          </linearGradient>
          <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0ea5e9"></stop>
            <stop offset="100%" stop-color="#2563eb"></stop>
          </linearGradient>
          <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="4" result="coloredBlur"
            ></feGaussianBlur>
            <feMerge>
              <feMergeNode in="coloredBlur"></feMergeNode>
              <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
          </filter>
        </defs>

        <ellipse
          cx="200"
          cy="405"
          rx="130"
          ry="12"
          fill="#0f172a"
          opacity="0.15"></ellipse>

        <path
          d="M165 330 Q200 390 235 330 Z"
          fill="url(#accentGrad)"
          opacity="0.85"
          filter="url(#glow)"></path>

        <rect x="185" y="130" width="30" height="40" rx="5" fill="#94a3b8"
        ></rect>

        <rect
          x="125"
          y="150"
          width="150"
          height="180"
          rx="45"
          fill="url(#bodyGrad)"
          stroke="#cbd5e1"
          stroke-width="2"></rect>

        <rect
          x="145"
          y="175"
          width="110"
          height="65"
          rx="16"
          fill="#f8fafc"
          stroke="#e2e8f0"
          stroke-width="2"></rect>
        <text
          x="200"
          y="210"
          text-anchor="middle"
          font-family="ui-sans-serif, system-ui, sans-serif"
          font-size="18"
          font-weight="800"
          fill="#1e293b"
          letter-spacing="1.5">JAYA</text
        >
        <text
          x="200"
          y="228"
          text-anchor="middle"
          font-family="ui-sans-serif, system-ui, sans-serif"
          font-size="11"
          font-weight="700"
          fill="#0ea5e9"
          letter-spacing="2">TECHNO</text
        >

        <line
          x1="160"
          y1="270"
          x2="240"
          y2="270"
          stroke="#cbd5e1"
          stroke-width="3"
          stroke-linecap="round"></line>
        <line
          x1="175"
          y1="285"
          x2="225"
          y2="285"
          stroke="#cbd5e1"
          stroke-width="3"
          stroke-linecap="round"></line>
        <line
          x1="190"
          y1="300"
          x2="210"
          y2="300"
          stroke="#cbd5e1"
          stroke-width="3"
          stroke-linecap="round"></line>

        <rect
          x="110"
          y="45"
          width="180"
          height="105"
          rx="35"
          fill="url(#bodyGrad)"
          stroke="#cbd5e1"
          stroke-width="2"></rect>

        <rect
          x="125"
          y="60"
          width="150"
          height="75"
          rx="22"
          fill="url(#screenGrad)"></rect>

          <g class="mascot-eye" aria-hidden="true">
            <ellipse cx="170" cy="98" rx="9" ry="8" fill="#38bdf8" filter="url(#glow)">
              <animate
                attributeName="ry"
                values="8;8;8;0.6;8;8"
                keyTimes="0;0.86;0.88;0.9;0.92;1"
                dur="5s"
                calcMode="spline"
                keySplines="0.4 0 0.2 1; 0.4 0 0.2 1; 0.8 0 0.2 0.9; 0.2 0.9 0.8 0; 0.4 0 0.2 1"
                repeatCount="indefinite"
              />
              <animate
                attributeName="cy"
                values="98;98;98;99.5;98;98"
                keyTimes="0;0.86;0.88;0.9;0.92;1"
                dur="5s"
                calcMode="spline"
                keySplines="0.4 0 0.2 1; 0.4 0 0.2 1; 0.8 0 0.2 0.9; 0.2 0.9 0.8 0; 0.4 0 0.2 1"
                repeatCount="indefinite"
              />
            </ellipse>
            <ellipse cx="173" cy="95" rx="3" ry="2.5" fill="#ffffff" opacity="0.95">
              <animate
                attributeName="opacity"
                values="1;1;1;0;1;1"
                keyTimes="0;0.86;0.88;0.9;0.92;1"
                dur="5s"
                repeatCount="indefinite"
              />
              <animate
                attributeName="ry"
                values="2.5;2.5;2.5;0;2.5;2.5"
                keyTimes="0;0.86;0.88;0.9;0.92;1"
                dur="5s"
                repeatCount="indefinite"
              />
            </ellipse>
          </g>

          <g class="mascot-eye" aria-hidden="true">
            <ellipse cx="230" cy="98" rx="9" ry="8" fill="#38bdf8" filter="url(#glow)">
              <animate
                attributeName="ry"
                values="8;8;8;0.6;8;8"
                keyTimes="0;0.86;0.88;0.9;0.92;1"
                dur="5s"
                calcMode="spline"
                keySplines="0.4 0 0.2 1; 0.4 0 0.2 1; 0.8 0 0.2 0.9; 0.2 0.9 0.8 0; 0.4 0 0.2 1"
                repeatCount="indefinite"
                begin="0.03s"
              />
              <animate
                attributeName="cy"
                values="98;98;98;99.5;98;98"
                keyTimes="0;0.86;0.88;0.9;0.92;1"
                dur="5s"
                calcMode="spline"
                keySplines="0.4 0 0.2 1; 0.4 0 0.2 1; 0.8 0 0.2 0.9; 0.2 0.9 0.8 0; 0.4 0 0.2 1"
                repeatCount="indefinite"
                begin="0.03s"
              />
            </ellipse>
            <ellipse cx="233" cy="95" rx="3" ry="2.5" fill="#ffffff" opacity="0.95">
              <animate
                attributeName="opacity"
                values="1;1;1;0;1;1"
                keyTimes="0;0.86;0.88;0.9;0.92;1"
                dur="5s"
                repeatCount="indefinite"
                begin="0.03s"
              />
              <animate
                attributeName="ry"
                values="2.5;2.5;2.5;0;2.5;2.5"
                keyTimes="0;0.86;0.88;0.9;0.92;1"
                dur="5s"
                repeatCount="indefinite"
                begin="0.03s"
              />
            </ellipse>
          </g>

        <circle
          cx="90"
          cy="190"
          r="16"
          fill="url(#bodyGrad)"
          stroke="#cbd5e1"
          stroke-width="2"></circle>
        <rect
          x="75"
          y="215"
          width="30"
          height="65"
          rx="15"
          fill="url(#bodyGrad)"
          stroke="#cbd5e1"
          stroke-width="2"></rect>

        <circle
          cx="310"
          cy="190"
          r="16"
          fill="url(#bodyGrad)"
          stroke="#cbd5e1"
          stroke-width="2"></circle>
        <rect
          x="295"
          y="215"
          width="30"
          height="65"
          rx="15"
          fill="url(#bodyGrad)"
          stroke="#cbd5e1"
          stroke-width="2"></rect>
      </svg>

      <div
        class="float-card-2 relative z-20 mx-auto mt-4 flex max-w-[240px] items-center gap-2.5 rounded-2xl border border-mint-accent glass-card px-4 py-3 sm:absolute sm:bottom-12 sm:left-6 sm:mx-0 sm:mt-0 sm:max-w-none sm:gap-3 sm:px-5 sm:py-3.5"
        aria-hidden="true"
      >
        <span
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-yellow sm:h-9 sm:w-9"
        >
          <svg
            class="h-4 w-4 text-teal sm:h-5 sm:w-5"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 15l-4-4 1.41-1.41L11 13.17l6.59-6.59L19 8l-8 8z"
            ></path>
          </svg>
        </span>
        <div class="min-w-0 flex flex-col text-left">
          <span
            class="text-[10px] font-bold uppercase tracking-wider text-teal-light sm:text-xs"
            >Client Trust</span
          >
          <span class="text-xs font-extrabold text-teal sm:text-sm"
            >5+ Tahun Pengalaman</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
