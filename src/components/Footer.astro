---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const menuLinks = [
  { href: "/", label: "Home" },
  { href: "/profil", label: "Profil" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/#kerjasama", label: "Blog / Artikel" },
  { href: "/#kontak", label: "Kontak" },
];

const serviceLinks = [
  { href: "/#solusi", label: "Digital Marketing" },
  { href: "/#solusi", label: "Software House" },
  { href: "/#solusi", label: "Training / Sertifikasi" },
  { href: "/#kerjasama", label: "Kerjasama" },
];

const otherLinks = [
  { href: "#", label: "Karir" },
  { href: "#", label: "Magang" },
  { href: "#", label: "Privacy policy" },
];
---

<footer
  class="bg-gradient-to-b from-mint to-mint-accent/40 pb-6 pt-12 sm:pb-8 sm:pt-16"
>
