---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  light?: boolean;
}

const { items, light = false } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class:list={[
    "flex flex-wrap items-center gap-2 text-sm",
    light ? "text-white/60" : "text-teal/70"
  ]}>
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <span aria-hidden="true" class={light ? "text-white/30" : "text-mint-accent"}>
              /
            </span>
          )}
          {item.href ? (
            <a href={item.href} class:list={["transition", light ? "hover:text-white" : "hover:text-teal"]}>
              {item.label}
            </a>
          ) : (
            <span class:list={["font-medium", light ? "text-white" : "text-teal"]} aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
