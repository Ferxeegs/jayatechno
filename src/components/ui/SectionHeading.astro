---
interface Props {
  id?: string;
  title: string;
  highlight?: string;
  subtitle?: string;
  align?: 'left' | 'center';
  light?: boolean;
  reveal?: boolean;
}

const { id, title, highlight, subtitle, align = 'left', light = false, reveal = false } = Astro.props;

const hasHighlight = highlight && title.includes(highlight);
const parts = hasHighlight ? title.split(highlight) : null;
---

<div
  data-reveal={reveal || undefined}
  class:list={[
    align === 'center' && 'mx-auto max-w-3xl text-center',
  ]}
>
  <h2
    id={id}
    class:list={[
      'text-3xl font-extrabold leading-tight sm:text-4xl',
      light ? 'text-white' : 'text-navy',
    ]}
  >
    {
      parts ? (
        <>
          {parts[0]}
          <span class="highlight-underline">{highlight}</span>
          {parts[1]}
        </>
      ) : (
        title
      )
    }
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          'mt-4 text-base leading-relaxed',
          light ? 'text-white/80' : 'text-body',
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
