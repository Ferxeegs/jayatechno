---
import Breadcrumb from '../ui/Breadcrumb.astro';
import { site } from '../../data/site';
import { portfolioStats } from '../../data/portfolio';
---

<section class="relative overflow-hidden bg-gradient-to-br from-navy via-teal to-[#0a4a5c] text-white" aria-labelledby="portfolio-hero-heading">
  <div class="absolute inset-0 opacity-25" aria-hidden="true">
    <div class="absolute right-0 top-0 h-[500px] w-[500px] rounded-full bg-yellow/20 blur-3xl"></div>
    <div class="absolute -bottom-40 left-0 h-80 w-80 rounded-full bg-teal-light/30 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <Breadcrumb
      items={[
        { label: 'Beranda', href: '/' },
        { label: 'Portfolio' },
      ]}
    />

    <div class="mt-2 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-yellow">Portofolio Karya</p>
      <h1 id="portfolio-hero-heading" class="mt-4 text-balance text-4xl font-extrabold leading-tight sm:text-5xl lg:text-6xl">
        Proyek yang Membawa Hasil Nyata
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-white/85">
        Jelajahi karya {site.name} di bidang digital marketing, pengembangan software, dan solusi untuk instansi —
        dirancang dengan standar profesional dan dampak terukur.
      </p>
    </div>

    <dl class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-6">
      {
        portfolioStats.map((stat) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-5 backdrop-blur-sm sm:px-5">
            <dt class="text-2xl font-extrabold text-yellow sm:text-3xl">{stat.value}</dt>
            <dd class="mt-1 text-xs font-medium text-white/75 sm:text-sm">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
