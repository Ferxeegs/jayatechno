---
import SectionHeading from '../ui/SectionHeading.astro';
import { differentiators, certifications } from '../../data/profile';
---

<section class="bg-mint py-16 sm:py-24" aria-labelledby="strengths-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div data-reveal-variant="left" data-reveal>
        <SectionHeading
          id="strengths-heading"
          title="Mengapa Memilih Jayatechno"
          highlight="Jayatechno"
          subtitle="Keunggulan yang membedakan kami dari penyedia layanan digital pada umumnya."
        />
        <ul class="mt-8 space-y-4" role="list" data-reveal-stagger>
          {
            differentiators.map((item) => (
              <li data-reveal-item class="flex items-start gap-4 rounded-xl bg-white p-4 shadow-sm">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-teal text-white" aria-hidden="true">
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
                <span class="text-sm font-medium leading-relaxed text-navy sm:text-base">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal-variant="right" data-reveal>
        <h3 class="text-xl font-bold text-navy">Sertifikasi & Kemitraan</h3>
        <p class="mt-3 text-sm leading-relaxed text-body">
          Kami mempertahankan standar profesional melalui kemitraan resmi dan kepatuhan regulasi industri.
        </p>
        <ul class="mt-6 space-y-3" role="list" data-reveal-stagger>
          {
            certifications.map((cert) => (
              <li data-reveal-item class="flex items-center gap-3 rounded-xl border border-mint-accent bg-white px-5 py-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-yellow/30" aria-hidden="true">
                  <svg class="h-5 w-5 text-teal" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 15l-4-4 1.41-1.41L11 13.17l6.59-6.59L19 8l-8 8z" />
                  </svg>
                </span>
                <span class="text-sm font-semibold text-navy">{cert}</span>
              </li>
            ))
          }
        </ul>

        <div class="hover-lift mt-8 rounded-2xl bg-teal p-6 text-white">
          <h4 class="font-bold">Komitmen Kualitas</h4>
          <p class="mt-2 text-sm leading-relaxed text-white/85">
            Setiap proyek melalui QA, dokumentasi, dan serah terima terstruktur. Kami menjamin transparansi
            timeline, anggaran, dan hasil yang terukur.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
