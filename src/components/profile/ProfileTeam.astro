---
import SectionHeading from '../ui/SectionHeading.astro';
import { leadership } from '../../data/profile';
---

<section class="bg-white py-16 sm:py-24" aria-labelledby="team-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="team-heading"
      title="Kepemimpinan & Tim Manajemen"
      highlight="Manajemen"
      subtitle="Dipimpin oleh praktisi berpengalaman di bidang teknologi, bisnis, dan pemasaran digital."
      align="center"
      reveal
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        leadership.map((person) => (
          <article
            data-reveal-item
            class="hover-lift group overflow-hidden rounded-2xl border border-mint-accent bg-white shadow-sm"
          >
            <div
              class="aspect-[4/5] bg-gradient-to-br from-mint-accent via-mint to-teal-light/30"
              role="img"
              aria-label={`Foto ${person.name}`}
            >
              {/* <div class="flex h-full items-end p-5">
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-teal text-xl font-bold text-white">
                  {person.name.charAt(0)}
                </div>
              </div> */}
            </div>
            <div class="p-5">
              <h3 class="font-bold text-navy">{person.name}</h3>
              <p class="mt-1 text-sm font-semibold text-teal-light">{person.role}</p>
              <p class="mt-2 text-xs text-body">{person.focus}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p data-reveal class="mx-auto mt-10 max-w-2xl text-center text-sm text-body">
      Di balik kepemimpinan, 10+ profesional di divisi engineering, creative, marketing, dan project management
      siap mendukung proyek Anda.
    </p>
  </div>
</section>
