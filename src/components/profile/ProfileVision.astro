---
import SectionHeading from '../ui/SectionHeading.astro';
import { visionMission } from '../../data/profile';
---

<section id="visi-misi" class="bg-mint py-16 sm:py-24" aria-labelledby="vmv-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="vmv-heading"
      title="Visi, Misi & Nilai Perusahaan"
      highlight="Nilai"
      subtitle="Landasan yang memandu setiap keputusan strategis dan operasional kami."
      align="center"
    />

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl bg-white p-8 shadow-lg shadow-teal/5 ring-1 ring-mint-accent/60 lg:p-10">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-teal text-white" aria-hidden="true">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-bold text-navy">Visi</h3>
        <p class="mt-4 leading-relaxed text-body">{visionMission.vision}</p>
      </article>

      <article class="rounded-3xl bg-white p-8 shadow-lg shadow-teal/5 ring-1 ring-mint-accent/60 lg:p-10">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-yellow text-navy" aria-hidden="true">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-bold text-navy">Misi</h3>
        <p class="mt-4 leading-relaxed text-body">{visionMission.mission}</p>
      </article>
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        visionMission.values.map((value, i) => (
          <article class="group rounded-2xl bg-white/80 p-6 transition hover:bg-white hover:shadow-md">
            <span class="text-3xl font-extrabold text-mint-accent transition group-hover:text-yellow">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 font-bold text-navy">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body">{value.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
