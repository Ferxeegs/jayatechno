---
import SectionHeading from '../ui/SectionHeading.astro';
import { businessUnits } from '../../data/profile';
---

<section class="bg-navy py-16 text-white sm:py-24" aria-labelledby="business-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="business-heading"
      title="Unit Bisnis & Layanan"
      highlight="Layanan"
      subtitle="Empat pilar layanan yang menjadi fondasi solusi end-to-end kami."
      align="center"
      light
      reveal
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2" data-reveal-stagger>
      {
        businessUnits.map((unit) => (
          <article
            data-reveal-item
            class="hover-lift group rounded-2xl border border-white/10 bg-white/5 p-7 transition hover:border-yellow/40 hover:bg-white/10"
          >
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-yellow/20 text-yellow" aria-hidden="true">
              {unit.icon === 'marketing' && (
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3 17l6-6 4 4 8-10" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {unit.icon === 'software' && (
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
              )}
              {unit.icon === 'training' && (
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                  <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5" />
                </svg>
              )}
              {unit.icon === 'consulting' && (
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 16v-4M12 8h.01" stroke-linecap="round" />
                </svg>
              )}
            </div>
            <h3 class="mt-5 text-lg font-bold">{unit.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/75">{unit.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
