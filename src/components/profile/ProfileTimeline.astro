---
import SectionHeading from '../ui/SectionHeading.astro';
import { milestones } from '../../data/profile';
---

<section class="bg-white py-16 sm:py-24" aria-labelledby="timeline-heading">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="timeline-heading"
      title="Perjalanan Kami"
      highlight="Kami"
      subtitle="Tonggak penting dalam pertumbuhan Jayatechno sebagai mitra digital terpercaya."
      align="center"
    />

    <ol class="relative mt-14 space-y-0">
      <div class="absolute left-[19px] top-2 h-[calc(100%-2rem)] w-0.5 bg-gradient-to-b from-teal-light via-yellow to-mint-accent" aria-hidden="true"></div>
      {
        milestones.map((item) => (
          <li class="relative flex gap-6 pb-10 last:pb-0">
            <div class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-4 border-white bg-yellow shadow-md" aria-hidden="true">
              <span class="h-2 w-2 rounded-full bg-teal"></span>
            </div>
            <div class="pt-1">
              <time class="text-sm font-bold text-teal" datetime={item.year}>{item.year}</time>
              <h3 class="mt-1 text-lg font-bold text-navy">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-body">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
