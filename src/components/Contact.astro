---
import { site } from '../data/site';
---

<section
  id="kontak"
  class="relative overflow-hidden bg-gradient-to-b from-white via-mint/30 to-white py-20 sm:py-28"
  aria-labelledby="contact-heading"
>
  <!-- Decorative Background Shapes -->
  <div
    class="pointer-events-none absolute -right-32 top-0 h-96 w-96 rounded-full bg-teal-light/10 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -left-32 bottom-0 h-96 w-96 rounded-full bg-mint-accent/20 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-20 lg:px-8 z-10">
    <!-- Left Column: Glassmorphic Form Card -->
    <div class="contact-left-wrapper rounded-[2.5rem] bg-gradient-to-br from-mint-accent/40 to-teal-light/25 p-3 shadow-xl sm:p-4" data-reveal>
      <form
        class="rounded-[2rem] border border-white bg-white/80 p-6 sm:p-10 shadow-inner backdrop-blur-md text-left"
        method="post"
        action="#"
        aria-label="Formulir konsultasi"
      >
        <div class="space-y-6">
          <div>
            <label for="nama" class="mb-2 block text-sm font-bold text-navy">Nama Lengkap</label>
            <input
              type="text"
              id="nama"
              name="nama"
              required
              autocomplete="name"
              placeholder="Masukkan nama Anda"
              class="w-full rounded-xl border border-slate-100 bg-white/90 px-4 py-3.5 text-sm text-navy outline-none transition duration-300 focus:border-teal-light focus:ring-4 focus:ring-teal-light/10 shadow-sm"
            />
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm font-bold text-navy">Alamat Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="Masukkan email Anda"
              class="w-full rounded-xl border border-slate-100 bg-white/90 px-4 py-3.5 text-sm text-navy outline-none transition duration-300 focus:border-teal-light focus:ring-4 focus:ring-teal-light/10 shadow-sm"
            />
          </div>
          <div>
            <label for="pesan" class="mb-2 block text-sm font-bold text-navy">Deskripsi Kebutuhan</label>
            <textarea
              id="pesan"
              name="pesan"
              required
              rows="4"
              placeholder="Ceritakan proyek atau kebutuhan digital Anda..."
              class="w-full resize-y rounded-xl border border-slate-100 bg-white/90 px-4 py-3.5 text-sm text-navy outline-none transition duration-300 focus:border-teal-light focus:ring-4 focus:ring-teal-light/10 shadow-sm"
            ></textarea>
          </div>
        </div>
        <button
          type="submit"
          class="mt-8 w-full cursor-pointer rounded-xl bg-yellow py-4 text-sm font-extrabold text-navy transition duration-300 hover:bg-yellow-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow"
        >
          Kirim Pesan Sekarang
        </button>
      </form>
    </div>

    <!-- Right Column: Content Detail -->
    <div class="contact-right-wrapper text-left" data-reveal>
      <span class="text-xs font-bold uppercase tracking-widest text-teal-light mb-3 block">Hubungi Kami</span>
      <h2 id="contact-heading" class="text-3xl font-black leading-tight text-navy sm:text-4xl tracking-tight">
        Jadwalkan <span class="highlight-underline">Konsultasi</span> Dengan Praktisi Kami
      </h2>
      <p class="mt-6 text-base leading-relaxed text-body sm:text-lg">
        Ceritakan kebutuhan digital Anda — tim kami siap memberikan rekomendasi strategi, estimasi, dan solusi yang
        sesuai dengan tujuan bisnis atau instansi Anda.
      </p>

      <address class="mt-12 space-y-6 not-italic">
        <div class="contact-item flex gap-5 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition duration-300 hover:border-mint-accent hover:shadow-md group">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-mint to-mint-accent text-teal-light group-hover:from-teal group-hover:to-navy group-hover:text-yellow transition-all duration-300 shadow-sm" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
              <circle cx="12" cy="9" r="2.5" />
            </svg>
          </span>
          <div>
            <h3 class="font-extrabold text-navy tracking-tight">Kantor Kami</h3>
            <p class="mt-1.5 text-sm text-body leading-relaxed">{site.address}</p>
          </div>
        </div>
        
        <div class="contact-item flex gap-5 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition duration-300 hover:border-mint-accent hover:shadow-md group">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-mint to-mint-accent text-teal-light group-hover:from-teal group-hover:to-navy group-hover:text-yellow transition-all duration-300 shadow-sm" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                stroke-linejoin="round"
              />
              <path d="M22 6l-10 7L2 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div>
            <h3 class="font-extrabold text-navy tracking-tight">Surat Elektronik (Email)</h3>
            <p class="mt-1.5">
              <a href={`mailto:${site.email}`} class="text-sm font-semibold text-teal-light hover:text-teal hover:underline transition-colors">{site.email}</a>
            </p>
          </div>
        </div>
      </address>
    </div>
  </div>
</section>
