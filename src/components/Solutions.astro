---
const services = [
  {
    title: 'Digital Marketing',
    description:
      'Tingkatkan visibilitas dan hasil bisnis dengan layanan SEO, iklan digital, dan manajemen media sosial yang dirancang untuk membawa lebih banyak pelanggan.',
    icon: 'monitor',
    featured: false,
  },
  {
    title: 'Software House',
    description:
      'Kami bukan sekadar penyedia layanan, tapi mitra yang siap membantu Anda mengembangkan website, aplikasi, dan sistem bisnis yang benar-benar bekerja.',
    icon: 'mobile',
    featured: false,
  },
  {
    title: 'Training & Sertifikasi',
    description:
      'Pelatihan tematik untuk instansi, perusahaan, hingga UMKM terkait IT dan Digital. Kami juga berkolaborasi dalam uji kompetensi & sertifikasi.',
    icon: 'certificate',
    featured: true,
  },
];
---

<section id="solusi" class="relative overflow-hidden bg-white py-20 sm:py-28" aria-labelledby="solutions-heading">
  <div class="pointer-events-none absolute -left-48 top-1/4 h-96 w-96 rounded-full bg-mint-accent/20 blur-3xl" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-end gap-8 lg:grid-cols-2 lg:gap-16" data-reveal>
      <div>
        <span class="mb-3 block text-xs font-bold uppercase tracking-widest text-teal-light">Layanan Solutif</span>
        <h2 id="solutions-heading" class="text-3xl font-extrabold leading-tight text-navy sm:text-4xl">
          Solusi untuk Kinerja yang <span class="highlight-underline">Lebih</span> Efektif
        </h2>
      </div>
      <p class="text-base leading-relaxed text-body sm:text-lg lg:pb-1">
        Kami membantu bisnis dan instansi berkembang dengan strategi digital yang tepat, mulai dari pemasaran online
        hingga teknologi berbasis data berkualitas tinggi.
      </p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-3" data-reveal-stagger>
      {
        services.map((service) => (
          <article
            data-reveal-item
            class:list={[
              'solution-card transform-gpu group rounded-3xl border p-8 transition duration-300 will-change-[transform,opacity]',
              service.featured
                ? 'glass-card-featured relative overflow-hidden bg-gradient-to-br from-white via-mint/30 to-mint-accent/20 shadow-lg hover:-translate-y-1'
                : 'glass-card hover:-translate-y-1 hover:border-mint-accent hover:shadow-xl hover:shadow-teal/5',
            ]}
          >
            {service.featured && (
              <span class="absolute -right-12 -top-12 h-24 w-24 rounded-full bg-yellow/40 blur-xl" aria-hidden="true"></span>
            )}

            <div
              class:list={[
                'mb-6 flex h-16 w-16 items-center justify-center rounded-2xl shadow-sm transition duration-300 group-hover:scale-105',
                service.featured
                  ? 'bg-gradient-to-br from-teal to-navy text-yellow'
                  : 'bg-gradient-to-br from-mint to-mint-accent text-teal-light',
              ]}
              aria-hidden="true"
            >
              {service.icon === 'monitor' && (
                <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2" y="3" width="20" height="14" rx="2" />
                  <path d="M8 21h8M12 17v4" stroke-linecap="round" />
                  <path d="M7 10h4v4H7zM13 8h4v6h-4z" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {service.icon === 'mobile' && (
                <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="7" y="2" width="10" height="20" rx="2" />
                  <path d="M12 18h.01" stroke-linecap="round" />
                  <path d="M9 6l6 4-6 4V6z" stroke-linejoin="round" />
                </svg>
              )}
              {service.icon === 'certificate' && (
                <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                  <path d="M14 2v6h6M9 15l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </div>

            <h3 class="text-xl font-extrabold tracking-tight text-navy transition-colors group-hover:text-teal">
              {service.title}
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-body">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
